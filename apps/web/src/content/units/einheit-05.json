  "dialoge": [
    {
      "id": "d-5-1",
      "einheit": 5,
      "dialog": 1,
      "titel": "في الْمَطْعَمِ",
      "zeilen": [
        {
          "sp": "النّادِل",
          "ar": "أَهْلاً وَسَهْلاً. ماذا تُريدُ؟",
          "de": "Herzlich willkommen. Was möchtest du?"
        },
        {
          "sp": "عُمَر",
          "ar": "أُريدُ دَجاجاً وَأَرُزّاً، مِنْ فَضْلِكَ.",
          "de": "Ich möchte Hähnchen und Reis, bitte."
        },
        {
          "sp": "النّادِل",
          "ar": "وَماذا تَشْرَبُ؟",
          "de": "Und was trinkst du?"
        },
        {
          "sp": "عُمَر",
          "ar": "أَشْرَبُ عَصيرَ تُفّاحٍ.",
          "de": "Ich trinke Apfelsaft."
        },
        {
          "sp": "النّادِل",
          "ar": "وَأَنْتَ يا يوسُفُ؟",
          "de": "Und du, Yūsuf?"
        },
        {
          "sp": "يوسُف",
          "ar": "أَنا عَطْشانُ. أُريدُ ماءً وَشاياً.",
          "de": "Ich bin durstig. Ich möchte Wasser und Tee."
        }
      ]
    },
    {
      "id": "d-5-2",
      "einheit": 5,
      "dialog": 2,
      "titel": "الطَّعامُ لَذيذٌ",
      "zeilen": [
        {
          "sp": "سارَة",
          "ar": "ماذا تَطْبُخينَ يا أُمّي؟",
          "de": "Was kochst du, Mama?"
        },
        {
          "sp": "الْأُمّ",
          "ar": "أَطْبُخُ سَمَكاً وَخُضاراً.",
          "de": "Ich koche Fisch und Gemüse."
        },
        {
          "sp": "سارَة",
          "ar": "أَنا جائِعَةٌ جِدّاً!",
          "de": "Ich bin sehr hungrig!"
        },
        {
          "sp": "الْأُمّ",
          "ar": "الطَّعامُ عَلى الْمائِدَةِ. بِسْمِ اللهِ.",
          "de": "Das Essen steht auf dem Tisch. Im Namen Gottes."
        },
        {
          "sp": "سارَة",
          "ar": "ما شاءَ اللهُ، الطَّعامُ لَذيذٌ!",
          "de": "Wie schön, das Essen ist lecker!"
        }
      ]
    },
    {
      "id": "d-5-3",
      "einheit": 5,
      "dialog": 3,
      "titel": "ماذا تَأْكُلُ في الْفُطورِ؟",
      "zeilen": [
        {
          "sp": "سارَة",
          "ar": "ماذا تَأْكُلُ في الْفُطورِ يا عُمَرُ؟",
          "de": "Was isst du zum Frühstück, ʿUmar?"
        },
        {
          "sp": "عُمَر",
          "ar": "آكُلُ خُبْزاً وَبَيْضاً، وَأَشْرَبُ حَليباً.",
          "de": "Ich esse Brot und Eier und trinke Milch."
        },
        {
          "sp": "سارَة",
          "ar": "أَنا آكُلُ تَمْراً وَأَشْرَبُ قَهْوَةً.",
          "de": "Ich esse Datteln und trinke Kaffee."
        },
        {
          "sp": "عُمَر",
          "ar": "قَهْوَةٌ في الصَّباحِ؟",
          "de": "Kaffee am Morgen?"
        },
        {
          "sp": "سارَة",
          "ar": "نَعَمْ، دائِماً!",
          "de": "Ja, immer!"
        }
      ]
    }
  ]
}
