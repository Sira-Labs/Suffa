{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "ES2022.Intl"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src", "test"]
}
