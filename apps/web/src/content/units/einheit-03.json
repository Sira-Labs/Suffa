          "ar": "الْمِفْتاحُ عَلى الطّاوِلَةِ.",
          "de": "Der Schlüssel ist auf dem Tisch."
        },
        {
          "ar": "الْقِطُّ تَحْتَ السَّريرِ.",
          "de": "Die Katze ist unter dem Bett."
        }
      ],
      "fragen": [
        {
