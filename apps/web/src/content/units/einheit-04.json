          "ar": "مَتى نِمْتَ؟",
          "de": "Wann hast du geschlafen?"
        },
        {
          "ar": "ذَهَبَتْ إِلى السّوقِ.",
          "de": "Sie ging zum Markt."
        }
      ],
      "fragen": [
        {
          "id": "g-4-2#0",
          "frage": "„Ich habe geschrieben.“",
          "ar": null,
          "antwort": "كَتَبْتُ",
          "ablenker": ["كَتَبَ", "أَكْتُبُ", "كَتَبَتْ"]
        },
        {
          "id": "g-4-2#1",
          "frage": "„Sie ging.“",
          "ar": null,
          "antwort": "ذَهَبَتْ",
          "ablenker": ["ذَهَبْتُ", "تَذْهَبُ", "ذَهَبَ"]
        }
      ]
    },
    {
      "id": "g-4-3",
      "einheit": 4,
