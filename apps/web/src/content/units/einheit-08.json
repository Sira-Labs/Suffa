  "dialoge": [
    {
      "id": "d-8-1",
      "einheit": 8,
      "dialog": 1,
      "titel": "ما عَمَلُكَ؟",
      "zeilen": [
        {
          "sp": "يوسُف",
          "ar": "ما عَمَلُكَ يا عَمّي؟",
          "de": "Was arbeitest du, Onkel?"
        },
        {
          "sp": "الْعَمّ",
          "ar": "أَنا مُهَنْدِسٌ. أَعْمَلُ في شَرِكَةٍ كَبيرَةٍ.",
          "de": "Ich bin Ingenieur. Ich arbeite in einer großen Firma."
        },
        {
          "sp": "يوسُف",
          "ar": "مَتى تَحْضُرُ إِلى الشَّرِكَةِ؟",
          "de": "Wann kommst du in die Firma?"
        },
        {
          "sp": "الْعَمّ",
          "ar": "أَحْضُرُ السّاعَةَ الثّامِنَةَ صَباحاً.",
          "de": "Ich komme um acht Uhr morgens."
        },
        {
          "sp": "يوسُف",
          "ar": "هَلْ أَنْتَ مُتْعَبٌ بَعْدَ الْعَمَلِ؟",
          "de": "Bist du nach der Arbeit müde?"
        },
        {
          "sp": "الْعَمّ",
          "ar": "أَحْياناً، لٰكِنَّ الْعَمَلَ جَميلٌ.",
          "de": "Manchmal, aber die Arbeit ist schön."
        }
      ]
    },
    {
      "id": "d-8-2",
      "einheit": 8,
      "dialog": 2,
      "titel": "في الْعِيادَةِ",
      "zeilen": [
        {
          "sp": "مَرْيَم",
          "ar": "أَيْنَ تَعْمَلُ أُخْتُكِ؟",
          "de": "Wo arbeitet deine Schwester?"
        },
        {
          "sp": "سارَة",
          "ar": "تَعْمَلُ مُمَرِّضَةً في عِيادَةٍ قَريبَةٍ.",
          "de": "Sie arbeitet als Krankenschwester in einer Praxis in der Nähe."
        },
        {
          "sp": "مَرْيَم",
          "ar": "هِيَ مَشْغولَةٌ دائِماً!",
          "de": "Sie ist immer beschäftigt!"
        },
        {
          "sp": "سارَة",
          "ar": "نَعَمْ، تَفْتَحُ الْعِيادَةَ مُبَكِّراً كُلَّ يَوْمٍ.",
          "de": "Ja, sie öffnet die Praxis jeden Tag früh."
        }
      ]
    },
    {
      "id": "d-8-3",
      "einheit": 8,
      "dialog": 3,
      "titel": "في الْمَزْرَعَةِ",
      "zeilen": [
        {
          "sp": "يوسُف",
          "ar": "أَيْنَ يَعْمَلُ جَدُّكَ يا عُمَرُ؟",
          "de": "Wo arbeitet dein Großvater, ʿUmar?"
        },
        {
          "sp": "عُمَر",
          "ar": "جَدّي فَلّاحٌ. يَعْمَلُ في مَزْرَعَةٍ في الْقَرْيَةِ.",
          "de": "Mein Großvater ist Bauer. Er arbeitet auf einem Hof im Dorf."
        },
        {
          "sp": "يوسُف",
          "ar": "هَلْ عَمَلُهُ صَعْبٌ؟",
          "de": "Ist seine Arbeit schwer?"
        },
        {
          "sp": "عُمَر",
          "ar": "نَعَمْ، لٰكِنَّهُ نَشيطٌ جِدّاً. يَحْضُرُ إِلى الْمَزْرَعَةِ بَعْدَ الْفَجْرِ.",
          "de": "Ja, aber er ist sehr tatkräftig. Er ist schon nach dem Morgengebet auf dem Hof."
        }
      ]
    }
  ]
}
