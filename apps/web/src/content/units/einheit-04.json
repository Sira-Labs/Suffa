        {
          "sp": "الْأَب",
          "ar": "يا يوسُفُ، الصَّلاةُ!",
          "de": "Yūsuf, das Gebet!"
        },
        {
          "sp": "يوسُف",
          "ar": "كَمِ السّاعَةُ يا أَبي؟",
          "de": "Wie spät ist es, Vater?"
        },
        {
          "sp": "الْأَب",
          "ar": "السّاعَةُ الْخامِسَةُ.",
          "de": "Es ist fünf Uhr."
        },
        {
          "sp": "يوسُف",
          "ar": "نَخْرُجُ إِلى الْمَسْجِدِ مَعاً؟",
          "de": "Gehen wir zusammen zur Moschee?"
        },
        {
          "sp": "الْأَب",
          "ar": "نَعَمْ، ثُمَّ نَرْجِعُ لِلْفُطورِ.",
          "de": "Ja, danach kommen wir zum Frühstück zurück."
        }
      ]
    },
    {
      "id": "d-4-3",
