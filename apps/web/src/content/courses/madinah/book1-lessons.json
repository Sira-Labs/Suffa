      "grammar": [
        {
          "title": "„Das ist …“ ohne „ist“",
          "text": "Im Arabischen gibt es im Präsens kein „ist“. هٰذَا (dies) und das Nomen bilden schon einen ganzen Satz.",
          "examples": [
            {
              "ar": "هٰذَا قَلَمٌ.",
              "de": "Das ist ein Stift."
            },
            {
              "ar": "هٰذَا طَبِيبٌ.",
              "de": "Das ist ein Arzt."
            }
          ]
        },
        {
          "title": "Die Endung -un: „ein“",
          "text": "Das doppelte Vokalzeichen am Wortende (Tanwīn, gesprochen -un) zeigt, dass das Nomen unbestimmt ist: كِتَابٌ = „ein Buch“.",
          "examples": [
            {
              "ar": "كِتَابٌ",
              "de": "ein Buch"
            },
            {
              "ar": "كُرْسِيٌّ",
              "de": "ein Stuhl"
            }
          ]
        },
        {
          "title": "Fragen: مَا, مَنْ und أَ",
          "text": "مَا fragt nach Dingen und Tieren, مَنْ nach Menschen. Ein أَ vor dem Satz macht daraus eine Ja/Nein-Frage; die Antwort ist نَعَمْ oder لَا.",
          "examples": [
            {
              "ar": "مَا هٰذَا؟ هٰذَا مِفْتَاحٌ.",
              "de": "Was ist das? Das ist ein Schlüssel."
            },
            {
              "ar": "مَنْ هٰذَا؟ هٰذَا تَاجِرٌ.",
              "de": "Wer ist das? Das ist ein Händler."
            },
            {
              "ar": "أَهٰذَا بَابٌ؟ لَا، هٰذَا مَكْتَبٌ.",
              "de": "Ist das eine Tür? Nein, das ist ein Schreibtisch."
            }
          ]
        }
      ]
    },
