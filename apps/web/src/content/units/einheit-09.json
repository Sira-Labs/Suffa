  "dialoge": [
    {
      "id": "d-9-1",
      "einheit": 9,
      "dialog": 1,
      "titel": "في السّوقِ",
      "zeilen": [
        {
          "sp": "عُمَر",
          "ar": "بِكَمْ هٰذا الْقَميصُ؟",
          "de": "Wie viel kostet dieses Hemd?"
        },
        {
          "sp": "الْبائِع",
          "ar": "بِخَمْسينَ رِيالاً.",
          "de": "Fünfzig Riyal."
        },
        {
          "sp": "عُمَر",
          "ar": "هٰذا غالٍ! عِنْدَكَ قَميصٌ رَخيصٌ؟",
          "de": "Das ist teuer! Hast du ein billiges Hemd?"
        },
        {
          "sp": "الْبائِع",
          "ar": "نَعَمْ، هٰذا الْقَميصُ الْأَبْيَضُ بِثَلاثينَ رِيالاً.",
          "de": "Ja, dieses weiße Hemd kostet dreißig Riyal."
        },
        {
          "sp": "عُمَر",
          "ar": "طَيِّبٌ، أَدْفَعُ ثَلاثينَ رِيالاً.",
          "de": "Gut, ich zahle dreißig Riyal."
        }
      ]
    },
    {
      "id": "d-9-2",
      "einheit": 9,
      "dialog": 2,
      "titel": "هَدِيَّةٌ لِأُمّي",
      "zeilen": [
        {
          "sp": "الْبائِعَة",
          "ar": "ماذا تَطْلُبينَ؟",
          "de": "Was wünschst du?"
        },
        {
          "sp": "سارَة",
          "ar": "أُريدُ حَقيبَةً هَدِيَّةً لِأُمّي.",
          "de": "Ich möchte eine Tasche als Geschenk für meine Mutter."
        },
        {
          "sp": "الْبائِعَة",
          "ar": "عِنْدَنا حَقيبَةٌ سَوْداءُ وَحَقيبَةٌ حَمْراءُ.",
          "de": "Wir haben eine schwarze und eine rote Tasche."
        },
        {
          "sp": "سارَة",
          "ar": "الْحَمْراءُ جَميلَةٌ. بِكَمْ هِيَ؟",
          "de": "Die rote ist schön. Wie viel kostet sie?"
        },
        {
          "sp": "الْبائِعَة",
          "ar": "بِمِئَةِ رِيالٍ.",
          "de": "Hundert Riyal."
        },
        {
          "sp": "سارَة",
          "ar": "طَيِّبٌ، أَحْمِلُها مَعي.",
          "de": "Gut, ich nehme sie mit."
        }
      ]
    },
    {
      "id": "d-9-3",
      "einheit": 9,
      "dialog": 3,
      "titel": "ماذا نَشْتَري؟",
      "zeilen": [
        {
          "sp": "الْأُمّ",
          "ar": "ماذا نَشْتَري الْيَوْمَ يا سارَةُ؟",
          "de": "Was kaufen wir heute, Sāra?"
        },
        {
          "sp": "سارَة",
          "ar": "نَشْتَري خُضاراً وَفاكِهَةً وَخُبْزاً.",
          "de": "Wir kaufen Gemüse, Obst und Brot."
        },
        {
          "sp": "الْأُمّ",
          "ar": "بِكَمْ كيلو التُّفّاحِ؟",
          "de": "Wie viel kostet ein Kilo Äpfel?"
        },
        {
          "sp": "الْبائِع",
          "ar": "بِعَشَرَةِ رِيالاتٍ.",
          "de": "Zehn Riyal."
        },
        {
          "sp": "الْأُمّ",
          "ar": "طَيِّبٌ، نَشْتَري كيلو واحِداً.",
          "de": "Gut, wir kaufen ein Kilo."
        }
      ]
    }
  ],
  "grammatik": [
    {
      "id": "g-9-1",
      "einheit": 9,
      "abschnitt": 1,
      "titel": "هٰذا الْكِتابُ oder هٰذا كِتابٌ?",
      "regel": "هٰذا كِتابٌ = das ist ein Buch · هٰذا الْكِتابُ = dieses Buch",
      "erklaerung": [
        "Folgt auf هٰذا/هٰذِهِ ein unbestimmtes Nomen, entsteht ein Satz. Folgt ein bestimmtes Nomen, heißt es „dieser/diese …“.",
        "So: هٰذا الْقَميصُ جَميلٌ – Dieses Hemd ist schön."
      ],
      "beispiele": [
        {
          "ar": "هٰذا قَميصٌ.",
          "de": "Das ist ein Hemd."
        },
        {
          "ar": "هٰذا الْقَميصُ غالٍ.",
          "de": "Dieses Hemd ist teuer."
        },
        {
          "ar": "بِكَمْ هٰذِهِ الْحَقيبَةُ؟",
          "de": "Wie viel kostet diese Tasche?"
        }
      ],
      "fragen": [
        {
          "id": "g-9-1#0",
          "frage": "„Diese Tasche ist schön.“",
          "ar": null,
          "antwort": "هٰذِهِ الْحَقيبَةُ جَميلَةٌ.",
          "ablenker": [
            "هٰذِهِ حَقيبَةٌ جَميلَةٌ.",
            "هٰذا الْحَقيبَةُ جَميلٌ.",
            "الْحَقيبَةُ هٰذِهِ الْجَميلَةُ."
          ]
        },
        {
          "id": "g-9-1#1",
          "frage": "Was bedeutet هٰذا كِتابٌ?",
