{
  "name": "@suffa/api",
  "version": "0.1.0",
  "private": true,
  "description": "Suffa API and worker: health, config validation, migrations, sync endpoints, pg-boss job queue.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prebuild": "npm run build -w @suffa/engagement -w @suffa/llm",
    "pretypecheck": "npm run build -w @suffa/engagement -w @suffa/llm",
    "eval": "node dist/evals/cli.js",
    "eval:import": "node dist/evals/import.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@better-auth/passkey": "1.7.6",
    "@hono/node-server": "^1.19.17",
    "@sentry/core": "^11.0.0",
    "@suffa/engagement": "0.1.0",
    "@suffa/llm": "0.1.0",
    "better-auth": "1.7.6",
    "hono": "^4.13.8",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.7",
    "pino": "^9.14.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "vitest": "^2.1.9"
  }
}
