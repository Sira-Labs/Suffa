        },
        {
          "ar": "الطّالِباتُ في الْمَكْتَبَةِ.",
          "de": "Die Studentinnen sind in der Bibliothek."
        },
        {
          "ar": "تَكَلَّمْتُ مَعَ الْمُهَنْدِسينَ.",
          "de": "Ich sprach mit den Ingenieuren."
        }
      ],
      "fragen": [
        {
          "id": "g-7-2#0",
          "frage": "Plural von مُدَرِّسَةٌ",
          "ar": null,
          "antwort": "مُدَرِّساتٌ",
          "ablenker": ["مُدَرِّسونَ", "مُدَرِّسَتانِ", "مَدارِسُ"]
        },
        {
          "id": "g-7-2#1",
          "frage": "Plural von مُسْلِمٌ (Nominativ)",
          "ar": null,
