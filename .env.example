# Supabase-Konfiguration für die Geräte-Synchronisation.
# Kopiere diese Datei nach `.env` und trage deine Projektwerte ein.
# Beide Werte findest du im Supabase-Dashboard unter: Project Settings → API.
#
# WICHTIG: Die echte `.env` ist in .gitignore und darf NIE committet werden.
# Der Anon-Key ist öffentlich (clientseitig); Datensicherheit kommt über RLS-Policies.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Sync ganz deaktivieren (reiner Offline-Betrieb, NoopSyncProvider).
# Wenn auf "false" gesetzt, wird kein Supabase-Client erstellt.
VITE_SYNC_ENABLED=true
