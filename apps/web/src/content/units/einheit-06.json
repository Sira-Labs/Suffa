  "dialoge": [
    {
      "id": "d-6-1",
      "einheit": 6,
      "dialog": 1,
      "titel": "وَقْتُ الصَّلاةِ",
      "zeilen": [
        {
          "sp": "عُمَر",
          "ar": "اِسْمَعْ، هٰذا الْأَذانُ!",
          "de": "Hör mal, das ist der Gebetsruf!"
        },
        {
          "sp": "يوسُف",
          "ar": "نَعَمْ، الْآنَ صَلاةُ الْعَصْرِ.",
          "de": "Ja, jetzt ist das Nachmittagsgebet."
        },
        {
          "sp": "عُمَر",
          "ar": "أَيْنَ الْمَسْجِدُ؟",
          "de": "Wo ist die Moschee?"
        },
        {
          "sp": "يوسُف",
          "ar": "الْمَسْجِدُ قَريبٌ، هُناكَ أَمامَ الْجامِعَةِ.",
          "de": "Die Moschee ist nah, dort vor der Universität."
        },
        {
          "sp": "عُمَر",
          "ar": "نُصَلّي مَعَ الْجَماعَةِ؟",
          "de": "Beten wir mit der Gemeinschaft?"
        },
        {
          "sp": "يوسُف",
          "ar": "نَعَمْ، الصَّلاةُ مَعَ الْجَماعَةِ خَيْرٌ.",
          "de": "Ja, das Gebet in Gemeinschaft ist gut."
        }
      ]
    },
    {
      "id": "d-6-2",
      "einheit": 6,
      "dialog": 2,
      "titel": "كَمْ رَكْعَةً؟",
      "zeilen": [
        {
          "sp": "مَرْيَم",
          "ar": "كَمْ رَكْعَةً في صَلاةِ الْمَغْرِبِ؟",
          "de": "Wie viele Rakʿas hat das Abendgebet?"
        },
        {
          "sp": "سارَة",
          "ar": "ثَلاثُ رَكَعاتٍ.",
          "de": "Drei Rakʿas."
        },
        {
          "sp": "مَرْيَم",
          "ar": "وَصَلاةُ الْفَجْرِ؟",
          "de": "Und das Morgengebet?"
        },
        {
          "sp": "سارَة",
          "ar": "رَكْعَتانِ. نَرْكَعُ وَنَسْجُدُ، ثُمَّ نَجْلِسُ.",
          "de": "Zwei. Wir verbeugen uns, werfen uns nieder und sitzen dann."
        },
        {
          "sp": "مَرْيَم",
          "ar": "جَزاكِ اللهُ خَيْراً!",
          "de": "Möge Gott es dir vergelten!"
        }
      ]
    },
    {
      "id": "d-6-3",
      "einheit": 6,
      "dialog": 3,
      "titel": "الْوُضوءُ قَبْلَ الصَّلاةِ",
      "zeilen": [
        {
          "sp": "الطِّفْل",
          "ar": "يا أَبي، هَلْ نُصَلّي الْآنَ؟",
          "de": "Papa, beten wir jetzt?"
        },
        {
          "sp": "الْأَب",
          "ar": "نَعَمْ، وَلٰكِنِ الْوُضوءُ قَبْلَ الصَّلاةِ.",
          "de": "Ja, aber vor dem Gebet kommt die Waschung."
        },
        {
          "sp": "الطِّفْل",
          "ar": "أَيْنَ الْقِبْلَةُ؟",
          "de": "Wo ist die Gebetsrichtung?"
        },
        {
          "sp": "الْأَب",
          "ar": "الْقِبْلَةُ هُناكَ. ضَعِ السَّجّادَةَ هُنا.",
          "de": "Die Qibla ist dort. Leg den Gebetsteppich hierhin."
        },
        {
          "sp": "الطِّفْل",
          "ar": "اللهُ أَكْبَرُ!",
          "de": "Allāhu akbar!"
        }
      ]
    }
  ]
