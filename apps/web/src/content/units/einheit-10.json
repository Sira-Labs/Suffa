  "dialoge": [
    {
      "id": "d-10-1",
      "einheit": 10,
      "dialog": 1,
      "titel": "كَيْفَ الْجَوُّ؟",
      "zeilen": [
        {
          "sp": "مَرْيَم",
          "ar": "كَيْفَ الْجَوُّ في الرِّياضِ الْيَوْمَ؟",
          "de": "Wie ist das Wetter heute in Riad?"
        },
        {
          "sp": "عُمَر",
          "ar": "الْجَوُّ حارٌّ جِدّاً، وَالشَّمْسُ تَسْطَعُ.",
          "de": "Es ist sehr heiß, und die Sonne scheint."
        },
        {
          "sp": "مَرْيَم",
          "ar": "كَمْ دَرَجَةُ الْحَرارَةِ؟",
          "de": "Wie hoch ist die Temperatur?"
        },
        {
          "sp": "عُمَر",
          "ar": "أَرْبَعونَ دَرَجَةً! وَكَيْفَ الْجَوُّ في أَلْمانِيا؟",
          "de": "Vierzig Grad! Und wie ist das Wetter in Deutschland?"
        },
        {
          "sp": "مَرْيَم",
          "ar": "الْجَوُّ بارِدٌ وَغائِمٌ، وَالْمَطَرُ يَنْزِلُ.",
          "de": "Es ist kalt und bewölkt, und es regnet."
        }
      ]
    },
    {
      "id": "d-10-2",
      "einheit": 10,
      "dialog": 2,
      "titel": "أَيُّ فَصْلٍ تُحِبُّ؟",
      "zeilen": [
        {
          "sp": "سارَة",
          "ar": "أَيُّ فَصْلٍ تُحِبُّ يا يوسُفُ؟",
          "de": "Welche Jahreszeit magst du, Yūsuf?"
        },
        {
          "sp": "يوسُف",
          "ar": "أُحِبُّ الرَّبيعَ لِأَنَّ الْجَوَّ مُعْتَدِلٌ.",
          "de": "Ich mag den Frühling, weil das Wetter mild ist."
        },
        {
          "sp": "سارَة",
          "ar": "أَنا أُحِبُّ الشِّتاءَ.",
          "de": "Ich mag den Winter."
        },
        {
          "sp": "يوسُف",
          "ar": "لِماذا؟",
          "de": "Warum?"
        },
        {
          "sp": "سارَة",
          "ar": "لِأَنَّ الثَّلْجَ يَنْزِلُ في الشِّتاءِ في بَلَدي.",
          "de": "Weil in meinem Land im Winter Schnee fällt."
        }
      ]
    },
    {
      "id": "d-10-3",
      "einheit": 10,
      "dialog": 3,
      "titel": "الْبَرْدُ",
      "zeilen": [
        {
          "sp": "عُمَر",
          "ar": "الْجَوُّ بارِدٌ الْيَوْمَ!",
          "de": "Heute ist es kalt!"
        },
        {
          "sp": "يوسُف",
          "ar": "نَعَمْ، وَالرّيحُ شَديدَةٌ.",
          "de": "Ja, und der Wind ist stark."
        },
        {
          "sp": "عُمَر",
          "ar": "أَنا لا أُحِبُّ الْبَرْدَ.",
          "de": "Ich mag die Kälte nicht."
        },
        {
          "sp": "يوسُف",
          "ar": "وَأَنا أُحِبُّهُ! الْجَوُّ في الصَّيْفِ حارٌّ جِدّاً.",
          "de": "Und ich mag sie! Im Sommer ist es sehr heiß."
        }
      ]
    }
  ],
  "grammatik": [
    {
      "id": "g-10-1",
      "einheit": 10,
      "abschnitt": 1,
      "titel": "Der Vergleich: أَكْبَرُ مِنْ",
      "regel": "أَفْعَلُ مِنْ = …er als",
      "erklaerung": [
        "Der Komparativ hat die Form أَفْعَلُ und ändert sich nicht nach Geschlecht: كَبير → أَكْبَرُ, بارِد → أَبْرَدُ.",
        "„als“ heißt مِنْ: الشِّتاءُ أَبْرَدُ مِنَ الْخَريفِ."
      ],
      "beispiele": [
        {
          "ar": "الصَّيْفُ أَحَرُّ مِنَ الرَّبيعِ.",
          "de": "Der Sommer ist heißer als der Frühling."
        },
        {
          "ar": "الْيَوْمُ أَبْرَدُ مِنْ أَمْسِ.",
          "de": "Heute ist es kälter als gestern."
        },
        {
          "ar": "مَكَّةُ أَحَرُّ مِنْ بَرْلينَ.",
          "de": "Mekka ist heißer als Berlin."
        }
      ],
      "fragen": [
        {
          "id": "g-10-1#0",
          "frage": "Komparativ von صَغيرٌ",
          "ar": null,
          "antwort": "أَصْغَرُ",
          "ablenker": ["صُغْرى", "صَغيرَةٌ", "مُصَغَّرٌ"]
        },
        {
          "id": "g-10-1#1",
          "frage": "„Sie ist größer als ich.“",
          "ar": null,
          "antwort": "هِيَ أَكْبَرُ مِنّي.",
          "ablenker": [
            "هِيَ كُبْرى مِنّي.",
            "هِيَ أَكْبَرُ مِنْ أَنا.",
            "هِيَ كَبيرَةٌ مِنّي."
          ]
        }
      ]
    },
    {
      "id": "g-10-2",
      "einheit": 10,
      "abschnitt": 2,
      "titel": "Welcher? – أَيُّ",
      "regel": "أَيُّ + Nomen im Genitiv, unbestimmt: أَيُّ فَصْلٍ؟",
      "erklaerung": [
        "أَيُّ bildet eine Genitivverbindung mit einem unbestimmten Nomen: أَيُّ يَوْمٍ؟ أَيُّ لَوْنٍ؟",
        "Die Antwort nennt das Gemeinte: أُحِبُّ الرَّبيعَ – Ich mag den Frühling."
      ],
      "beispiele": [
        {
          "ar": "أَيُّ فَصْلٍ تُحِبُّ؟",
          "de": "Welche Jahreszeit magst du?"
        },
        {
          "ar": "في أَيِّ شَهْرٍ؟",
          "de": "In welchem Monat?"
        },
        {
          "ar": "أَيُّ يَوْمٍ الْيَوْمَ؟",
          "de": "Welcher Tag ist heute?"
        }
      ],
      "fragen": [
        {
          "id": "g-10-2#0",
          "frage": "„Welche Stadt?“",
          "ar": null,
          "antwort": "أَيُّ مَدينَةٍ؟",
          "ablenker": ["أَيُّ الْمَدينَةُ؟", "أَيُّ مَدينَةٌ؟", "ما مَدينَةٍ؟"]
        },
        {
          "id": "g-10-2#1",
          "frage": "In welcher Form steht das Nomen nach أَيُّ?",
          "ar": null,
          "antwort": "unbestimmt, Genitiv",
          "ablenker": ["bestimmt, Nominativ", "Plural", "Akkusativ"]
        }
      ]
    },
    {
      "id": "g-10-3",
      "einheit": 10,
      "abschnitt": 3,
      "titel": "كانَ – war",
      "regel": "كانَ + Prädikat im Akkusativ: كانَ الْجَوُّ بارِداً",
      "erklaerung": [
        "كانَ macht einen Nominalsatz zur Vergangenheit. Das Prädikat steht dann im Akkusativ (-an).",
        "Es wird konjugiert wie ein Perfekt: كُنْتُ, كُنْتَ, كانَتْ."
      ],
      "beispiele": [
        {
          "ar": "كانَ الْجَوُّ جَميلاً.",
          "de": "Das Wetter war schön."
        },
        {
          "ar": "كانَتِ السَّماءُ صافِيَةً.",
          "de": "Der Himmel war klar."
        },
        {
          "ar": "كُنْتُ مَريضاً أَمْسِ.",
          "de": "Ich war gestern krank."
        }
      ],
      "fragen": [
        {
          "id": "g-10-3#0",
          "frage": "„Es war kalt.“ (der Tag)",
          "ar": null,
          "antwort": "كانَ الْيَوْمُ بارِداً.",
          "ablenker": [
            "كانَ الْيَوْمُ بارِدٌ.",
            "الْيَوْمُ كانَ بارِدٌ.",
            "كانَتِ الْيَوْمُ بارِدَةً."
          ]
        },
        {
          "id": "g-10-3#1",
          "frage": "„Ich war beschäftigt.“ (m)",
