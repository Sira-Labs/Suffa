        {
          "ar": "يَجِبُ أَنْ أَذْهَبَ إِلى الطَّبيبِ.",
          "de": "Ich muss zum Arzt gehen."
        },
        {
          "ar": "يَجِبُ عَلَيْها أَنْ تَرْتاحَ.",
          "de": "Sie muss sich ausruhen."
        }
      ],
      "fragen": [
