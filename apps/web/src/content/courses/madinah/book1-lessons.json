      ],
      "grammar": [
        {
          "title": "Nah und fern: هٰذَا und ذٰلِكَ",
          "text": "هٰذَا zeigt auf etwas in der Nähe, ذٰلِكَ auf etwas weiter weg. Beide stehen für männliche Nomen.",
          "examples": [
            {
              "ar": "هٰذَا بَيْتٌ وَذٰلِكَ مَسْجِدٌ.",
              "de": "Das hier ist ein Haus, und das dort ist eine Moschee."
            },
            {
              "ar": "مَنْ ذٰلِكَ؟ ذٰلِكَ إِمَامٌ.",
              "de": "Wer ist das dort? Das ist ein Imam."
            }
          ]
        },
        {
          "title": "وَ – „und“",
          "text": "وَ wird direkt an das nächste Wort geschrieben: وَذٰلِكَ.",
          "examples": [
            {
              "ar": "سُكَّرٌ وَلَبَنٌ",
              "de": "Zucker und Milch"
            }
          ]
        }
      ]
    },
