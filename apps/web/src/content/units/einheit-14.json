  "dialoge": [
    {
      "id": "d-14-1",
      "einheit": 14,
      "dialog": 1,
      "titel": "إِلى مَكَّةَ",
      "zeilen": [
        {
          "sp": "يوسُف",
          "ar": "سَأَذْهَبُ إِلى الْحَجِّ هٰذِهِ السَّنَةَ، إِنْ شاءَ اللهُ.",
          "de": "Ich gehe dieses Jahr zum Hadsch, so Gott will."
        },
        {
          "sp": "عُمَر",
          "ar": "ما شاءَ اللهُ! هَلْ عِنْدَكَ مَلابِسُ الْإِحْرامِ؟",
          "de": "Wie schön! Hast du die Iḥrām-Kleidung?"
        },
        {
          "sp": "يوسُف",
          "ar": "نَعَمْ، أَلْبَسُ الْإِحْرامَ قَبْلَ مَكَّةَ.",
          "de": "Ja, ich lege das Iḥrām vor Mekka an."
        },
        {
          "sp": "عُمَر",
          "ar": "وَبَعْدَ الطَّوافِ وَالسَّعْيِ؟",
          "de": "Und nach dem Ṭawāf und dem Saʿy?"
        },
        {
          "sp": "يوسُف",
          "ar": "أَحْلِقُ شَعْري، وَأَشْكُرُ اللهَ.",
          "de": "Ich rasiere mein Haar und danke Gott."
        }
      ]
    },
    {
      "id": "d-14-2",
      "einheit": 14,
      "dialog": 2,
      "titel": "عيدٌ مُبارَكٌ",
      "zeilen": [
        {
          "sp": "سارَة",
          "ar": "عيدٌ مُبارَكٌ يا مَرْيَمُ!",
          "de": "Gesegnetes Fest, Maryam!"
        },
        {
          "sp": "مَرْيَم",
          "ar": "عيدٌ مُبارَكٌ! هَلْ رَجَعَ أَبوكِ مِنَ الْحَجِّ؟",
          "de": "Gesegnetes Fest! Ist dein Vater vom Hadsch zurück?"
        },
        {
          "sp": "سارَة",
          "ar": "نَعَمْ، رَجَعَ أَمْسِ.",
          "de": "Ja, er ist gestern zurückgekehrt."
        },
        {
          "sp": "مَرْيَم",
          "ar": "الْحَمْدُ لِلَّهِ!",
          "de": "Gott sei Dank!"
        },
        {
          "sp": "سارَة",
          "ar": "وَمَعَهُ ماءُ زَمْزَمَ لَنا.",
          "de": "Und er hat Zamzam-Wasser für uns mitgebracht."
        }
      ]
    },
    {
      "id": "d-14-3",
      "einheit": 14,
      "dialog": 3,
      "titel": "يَوْمُ عَرَفَةَ",
      "zeilen": [
        {
          "sp": "مَرْيَم",
          "ar": "أَيْنَ الْحُجّاجُ الْيَوْمَ؟",
          "de": "Wo sind die Pilger heute?"
        },
        {
          "sp": "سارَة",
          "ar": "الْيَوْمَ يَوْمُ عَرَفَةَ. الْحُجّاجُ في عَرَفاتٍ.",
          "de": "Heute ist der Tag von ʿArafa. Die Pilger sind in ʿArafāt."
        },
        {
          "sp": "مَرْيَم",
          "ar": "ماذا يَفْعَلونَ هُناكَ؟",
          "de": "Was machen sie dort?"
        },
        {
          "sp": "سارَة",
          "ar": "يَدْعونَ اللهَ وَيَذْكُرونَهُ.",
          "de": "Sie bitten Gott und gedenken seiner."
        },
        {
          "sp": "مَرْيَم",
          "ar": "وَنَحْنُ نَصومُ هٰذا الْيَوْمَ، إِنْ شاءَ اللهُ.",
          "de": "Und wir fasten an diesem Tag, so Gott will."
        }
      ]
    }
  ]
}
