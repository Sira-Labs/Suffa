      "dialog": 1,
      "titel": "يَوْمُ عُمَرَ",
      "zeilen": [
        {
          "sp": "سارَة",
          "ar": "مَتى تَذْهَبُ إِلى الْجامِعَةِ يا عُمَرُ؟",
          "de": "Wann gehst du zur Universität, ʿUmar?"
        },
        {
          "sp": "عُمَر",
          "ar": "أَذْهَبُ صَباحاً بَعْدَ الْفُطورِ.",
          "de": "Ich gehe morgens nach dem Frühstück."
        },
        {
          "sp": "سارَة",
          "ar": "هَلْ تَذْهَبُ بِالسَّيّارَةِ؟",
          "de": "Fährst du mit dem Auto?"
        },
        {
          "sp": "عُمَر",
          "ar": "لا، أَذْهَبُ بِالْحافِلَةِ.",
          "de": "Nein, ich fahre mit dem Bus."
        },
        {
          "sp": "سارَة",
          "ar": "وَمَتى تَرْجِعُ إِلى الْبَيْتِ؟",
          "de": "Und wann kommst du nach Hause zurück?"
        },
        {
          "sp": "عُمَر",
          "ar": "أَرْجِعُ بَعْدَ الظُّهْرِ، ثُمَّ أَكْتُبُ الْواجِبَ.",
          "de": "Ich komme nachmittags zurück, dann schreibe ich die Hausaufgabe."
        }
      ]
    },
    {
      "id": "d-4-2",
      "einheit": 4,
      "dialog": 2,
      "titel": "صَلاةُ الْفَجْرِ",
