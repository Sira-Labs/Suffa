  "dialoge": [
    {
      "id": "d-15-1",
      "einheit": 15,
      "dialog": 1,
      "titel": "عِنْدَ الطَّبيبِ",
      "zeilen": [
        {
          "sp": "الطَّبيب",
          "ar": "ما بِكَ؟",
          "de": "Was fehlt dir?"
        },
        {
          "sp": "عُمَر",
          "ar": "أَشْعُرُ بِأَلَمٍ في رَأْسي، وَعِنْدي حُمّى.",
          "de": "Ich habe Kopfschmerzen, und ich habe Fieber."
        },
        {
          "sp": "الطَّبيب",
          "ar": "مُنْذُ مَتى؟",
          "de": "Seit wann?"
        },
        {
          "sp": "عُمَر",
          "ar": "مُنْذُ يَوْمَيْنِ.",
          "de": "Seit zwei Tagen."
        },
        {
          "sp": "الطَّبيب",
          "ar": "أَفْحَصُكَ الْآنَ ... عِنْدَكَ زُكامٌ. خُذْ هٰذا الدَّواءَ ثَلاثَ مَرّاتٍ في الْيَوْمِ.",
          "de": "Ich untersuche dich jetzt … Du hast eine Erkältung. Nimm dieses Medikament dreimal am Tag."
        },
        {
          "sp": "عُمَر",
          "ar": "شُكْراً يا دُكْتورُ.",
          "de": "Danke, Herr Doktor."
        }
      ]
    },
    {
      "id": "d-15-2",
      "einheit": 15,
      "dialog": 2,
      "titel": "شِفاءً عاجِلاً",
      "zeilen": [
        {
          "sp": "سارَة",
          "ar": "أَيْنَ مَرْيَمُ الْيَوْمَ؟",
          "de": "Wo ist Maryam heute?"
        },
        {
          "sp": "الْمُدَرِّسَة",
          "ar": "مَرْيَمُ مَريضَةٌ. عِنْدَها أَلَمٌ في بَطْنِها.",
          "de": "Maryam ist krank. Sie hat Bauchschmerzen."
        },
        {
          "sp": "سارَة",
          "ar": "مِسْكينَةٌ! أَذْهَبُ إِلَيْها بَعْدَ الدَّرْسِ.",
          "de": "Die Arme! Ich gehe nach dem Unterricht zu ihr."
        },
        {
          "sp": "الْمُدَرِّسَة",
          "ar": "قولي لَها: شِفاءً عاجِلاً.",
          "de": "Sag ihr: Gute Besserung."
        }
      ]
    },
    {
      "id": "d-15-3",
      "einheit": 15,
      "dialog": 3,
      "titel": "في الصَّيْدَلِيَّةِ",
      "zeilen": [
        {
          "sp": "عُمَر",
          "ar": "السَّلامُ عَلَيْكُمْ. أُريدُ هٰذا الدَّواءَ، مِنْ فَضْلِكَ.",
          "de": "Friede sei mit euch. Ich möchte dieses Medikament, bitte."
        },
        {
          "sp": "الصَّيْدَلِيّ",
          "ar": "هٰذا دَواءٌ لِلزُّكامِ. خُذْهُ بَعْدَ الطَّعامِ.",
          "de": "Das ist ein Mittel gegen Erkältung. Nimm es nach dem Essen."
        },
        {
          "sp": "عُمَر",
          "ar": "كَمْ مَرَّةً في الْيَوْمِ؟",
          "de": "Wie oft am Tag?"
        },
        {
          "sp": "الصَّيْدَلِيّ",
          "ar": "ثَلاثَ مَرّاتٍ. شِفاءً عاجِلاً!",
          "de": "Dreimal. Gute Besserung!"
        },
        {
          "sp": "عُمَر",
          "ar": "شُكْراً جَزيلاً.",
          "de": "Vielen Dank."
        }
      ]
    }
  ],
  "grammatik": [
    {
      "id": "g-15-1",
      "einheit": 15,
      "abschnitt": 1,
      "titel": "Objektendungen am Verb",
      "regel": "يُؤْلِمُني = es tut mir weh · ساعِدْني = hilf mir",
      "erklaerung": [
        "Das Objekt „mich“ wird als ـني an das Verb gehängt; die übrigen Objektendungen gleichen den Possessivendungen: ـكَ, ـهُ, ـها.",
        "Schmerzen: يُؤْلِمُني رَأْسي – Mein Kopf tut mir weh."
      ],
      "beispiele": [
        {
          "ar": "يُؤْلِمُني رَأْسي.",
          "de": "Mein Kopf tut mir weh."
        },
        {
          "ar": "فَحَصَني الطَّبيبُ.",
          "de": "Der Arzt hat mich untersucht."
        },
        {
          "ar": "سَأَزورُكَ غَداً.",
          "de": "Ich werde dich morgen besuchen."
        }
      ],
      "fragen": [
        {
          "id": "g-15-1#0",
          "frage": "„Der Arzt hat ihn untersucht.“",
          "ar": null,
          "antwort": "فَحَصَهُ الطَّبيبُ.",
          "ablenker": [
            "فَحَصَني الطَّبيبُ.",
            "فَحَصَها الطَّبيبُ.",
            "فَحَصَ هُوَ الطَّبيبُ."
          ]
        },
        {
          "id": "g-15-1#1",
          "frage": "Welche Endung heißt „mich“ am Verb?",
          "ar": null,
          "antwort": "ـني",
          "ablenker": ["ـي", "ـكَ", "ـنا"]
        }
      ]
    },
    {
      "id": "g-15-2",
      "einheit": 15,
      "abschnitt": 2,
      "titel": "Müssen: يَجِبُ أَنْ",
      "regel": "يَجِبُ أَنْ تَرْتاحَ = du musst dich ausruhen",
      "erklaerung": [
        "يَجِبُ bleibt unverändert; die Person steckt im Verb nach أَنْ, das im Subjunktiv (-a) steht.",
        "Mit عَلى geht es auch: يَجِبُ عَلَيْكَ أَنْ تَشْرَبَ الْماءَ."
      ],
      "beispiele": [
        {
          "ar": "يَجِبُ أَنْ تَشْرَبَ ماءً كَثيراً.",
