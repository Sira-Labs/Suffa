          "frage": "„immer“",
          "ar": null,
          "antwort": "دائِماً",
          "ablenker": ["أَحْياناً", "أَبَداً", "قَليلاً"]
        },
        {
          "id": "g-12-2#1",
          "frage": "„Ich zeichne jede Woche.“",
