          "ar": "السَّلامُ عَلَيْكُمْ.",
          "de": "Friede sei mit euch."
        },
        {
          "sp": "عُمَر",
          "ar": "وَعَلَيْكُمُ السَّلامُ.",
          "de": "Und mit euch sei der Friede."
        },
        {
          "sp": "يوسُف",
          "ar": "أَنا يوسُفُ. مَنْ أَنْتَ؟",
          "de": "Ich bin Yūsuf. Wer bist du?"
        },
        {
          "sp": "عُمَر",
          "ar": "أَنا عُمَرُ. أَنا طالِبٌ جَديدٌ.",
          "de": "Ich bin ʿUmar. Ich bin ein neuer Student."
        },
        {
          "sp": "يوسُف",
          "ar": "أَهْلاً وَسَهْلاً يا عُمَرُ. كَيْفَ حالُكَ؟",
          "de": "Herzlich willkommen, ʿUmar. Wie geht es dir?"
        },
        {
          "sp": "عُمَر",
          "ar": "بِخَيْرٍ، وَالْحَمْدُ لِلَّهِ. وَأَنْتَ؟",
          "de": "Gut, Gott sei Dank. Und dir?"
        },
        {
          "sp": "يوسُف",
          "ar": "أَنا بِخَيْرٍ، شُكْراً.",
          "de": "Mir geht es gut, danke."
        }
      ]
    },
