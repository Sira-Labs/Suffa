# Supabase configuration for cross-device sync.
# Copy this file to `.env` and fill in your project values.
# Both values are in the Supabase dashboard under: Project Settings → API.
#
# IMPORTANT: the real `.env` is in .gitignore and must NEVER be committed.
# The anon key is public (client-side); data security comes from RLS policies.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: disable sync entirely (pure offline mode, NoopSyncProvider).
# When set to "false", no Supabase client is created.
VITE_SYNC_ENABLED=true
