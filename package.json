{
  "name": "suffa",
  "version": "1.0.0",
  "private": true,
  "description": "Suffa (الصُّفَّة) – offline-first Arabic learning platform (MSA, Al-Arabiyya bayna Yadayk) with SRS, classes and multi-device sync.",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @suffa/web",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview -w @suffa/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces --if-present && npm run test:tools",
    "test:coverage": "npm run test:coverage -w @suffa/web",
    "test:tools": "node --test \"tools/**/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/node": "^22.19.21",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0"
  }
}
