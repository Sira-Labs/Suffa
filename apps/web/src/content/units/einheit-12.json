          "ar": "أَقْرَأُ كُلَّ يَوْمٍ.",
          "de": "Ich lese jeden Tag."
        },
        {
          "ar": "أَلْعَبُ كُرَةَ الْقَدَمِ أَحْياناً.",
          "de": "Manchmal spiele ich Fußball."
        },
        {
          "ar": "لا أُشاهِدُ التِّلْفازَ أَبَداً.",
          "de": "Ich sehe nie fern."
        }
      ],
      "fragen": [
        {
