  "dialoge": [
    {
      "id": "d-3-1",
      "einheit": 3,
      "dialog": 1,
      "titel": "أَيْنَ تَسْكُنينَ؟",
      "zeilen": [
        {
          "sp": "سارَة",
          "ar": "أَيْنَ تَسْكُنينَ يا مَرْيَمُ؟",
          "de": "Wo wohnst du, Maryam?"
        },
        {
          "sp": "مَرْيَم",
          "ar": "أَسْكُنُ في شَقَّةٍ قَريبَةٍ مِنَ الْجامِعَةِ.",
          "de": "Ich wohne in einer Wohnung nahe der Universität."
        },
        {
          "sp": "سارَة",
          "ar": "هَلِ الشَّقَّةُ واسِعَةٌ؟",
          "de": "Ist die Wohnung geräumig?"
        },
        {
          "sp": "مَرْيَم",
          "ar": "لا، هِيَ صَغيرَةٌ: غُرْفَتانِ وَمَطْبَخٌ وَحَمّامٌ.",
          "de": "Nein, sie ist klein: zwei Zimmer, eine Küche und ein Bad."
        },
        {
          "sp": "سارَة",
          "ar": "أَنا أَسْكُنُ في بَيْتٍ كَبيرٍ مَعَ أُسْرَتي. عِنْدَنا حَديقَةٌ.",
          "de": "Ich wohne mit meiner Familie in einem großen Haus. Wir haben einen Garten."
        }
      ]
    },
    {
      "id": "d-3-2",
      "einheit": 3,
      "dialog": 2,
      "titel": "أَيْنَ الْمِفْتاحُ؟",
      "zeilen": [
        {
          "sp": "الْأُمّ",
          "ar": "أَيْنَ الْمِفْتاحُ يا يوسُفُ؟",
          "de": "Wo ist der Schlüssel, Yūsuf?"
        },
        {
          "sp": "يوسُف",
          "ar": "الْمِفْتاحُ عَلى الْمَكْتَبِ.",
          "de": "Der Schlüssel ist auf dem Schreibtisch."
        },
        {
          "sp": "الْأُمّ",
          "ar": "لا، هُوَ لَيْسَ هُنا.",
          "de": "Nein, er ist nicht hier."
        },
        {
          "sp": "يوسُف",
          "ar": "هُوَ تَحْتَ الْكُرْسِيِّ، هُناكَ!",
          "de": "Er ist unter dem Stuhl, dort!"
        },
        {
          "sp": "الْأُمّ",
          "ar": "نَعَمْ، شُكْراً يا يوسُفُ.",
          "de": "Ja, danke, Yūsuf."
        }
      ]
    }
  ]
}
