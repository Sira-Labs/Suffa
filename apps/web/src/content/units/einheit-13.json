  "dialoge": [
    {
      "id": "d-13-1",
      "einheit": 13,
      "dialog": 1,
      "titel": "في الْمَطارِ",
      "zeilen": [
        {
          "sp": "الْمُوَظَّف",
          "ar": "جَوازُ السَّفَرِ، مِنْ فَضْلِكِ.",
          "de": "Den Reisepass, bitte."
        },
        {
          "sp": "سارَة",
          "ar": "تَفَضَّلْ. هٰذا جَوازي، وَهٰذِهِ التَّأْشيرَةُ.",
          "de": "Bitte. Das ist mein Pass, und das ist das Visum."
        },
        {
          "sp": "الْمُوَظَّف",
          "ar": "إِلى أَيْنَ؟",
          "de": "Wohin?"
        },
        {
          "sp": "سارَة",
          "ar": "إِلى جِدَّةَ.",
          "de": "Nach Dschidda."
        },
        {
          "sp": "الْمُوَظَّف",
          "ar": "الطّائِرَةُ في السّاعَةِ الْعاشِرَةِ. رِحْلَةً سَعيدَةً!",
          "de": "Das Flugzeug geht um zehn Uhr. Gute Reise!"
        }
      ]
    },
    {
      "id": "d-13-2",
      "einheit": 13,
      "dialog": 2,
      "titel": "بِالْقِطارِ",
      "zeilen": [
        {
          "sp": "عُمَر",
          "ar": "هَلْ حَجَزْتَ التَّذْكِرَةَ يا يوسُفُ؟",
          "de": "Hast du das Ticket gebucht, Yūsuf?"
        },
        {
          "sp": "يوسُف",
          "ar": "نَعَمْ، حَجَزْتُ تَذْكِرَتَيْنِ لِلْقِطارِ إِلى الْمَدينَةِ.",
          "de": "Ja, ich habe zwei Zugtickets nach Medina gebucht."
        },
        {
          "sp": "عُمَر",
          "ar": "مَتى نَرْكَبُ الْقِطارَ؟",
          "de": "Wann steigen wir in den Zug?"
        },
        {
          "sp": "يوسُف",
          "ar": "غَداً صَباحاً مِنَ الْمَحَطَّةِ. الْقِطارُ سَريعٌ جِدّاً.",
          "de": "Morgen früh am Bahnhof. Der Zug ist sehr schnell."
        },
        {
          "sp": "عُمَر",
          "ar": "مُمْتازٌ!",
          "de": "Ausgezeichnet!"
        }
      ]
    },
    {
      "id": "d-13-3",
      "einheit": 13,
      "dialog": 3,
      "titel": "في الْفُنْدُقِ",
      "zeilen": [
        {
          "sp": "الْمُوَظَّف",
          "ar": "أَهْلاً وَسَهْلاً! هَلْ عِنْدَكَ حَجْزٌ؟",
          "de": "Herzlich willkommen! Haben Sie eine Reservierung?"
        },
        {
          "sp": "عُمَر",
          "ar": "نَعَمْ، حَجَزْتُ غُرْفَةً لِثَلاثَةِ أَيّامٍ. أُسافِرُ بَعْدَ ذٰلِكَ إِلى الْمَدينَةِ.",
          "de": "Ja, ich habe ein Zimmer für drei Tage gebucht. Danach reise ich nach Medina."
        },
        {
          "sp": "الْمُوَظَّف",
          "ar": "هٰذا مِفْتاحُ الْغُرْفَةِ، في الطّابِقِ الرّابِعِ.",
          "de": "Hier ist der Zimmerschlüssel, im vierten Stock."
        },
        {
          "sp": "عُمَر",
          "ar": "شُكْراً. مَتى الْفُطورُ؟",
          "de": "Danke. Wann gibt es Frühstück?"
        },
        {
          "sp": "الْمُوَظَّف",
          "ar": "مِنَ السّاعَةِ السّادِسَةِ إِلى السّاعَةِ الْعاشِرَةِ.",
          "de": "Von sechs bis zehn Uhr."
        }
      ]
    }
  ],
