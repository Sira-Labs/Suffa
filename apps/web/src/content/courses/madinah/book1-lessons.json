      "grammar": [
        {
          "title": "Der Artikel اَلْ – „der, die, das“",
          "text": "اَلْ macht ein Nomen bestimmt. Dann fällt die Endung -un weg und wird zu -u: بَيْتٌ (ein Haus) → اَلْبَيْتُ (das Haus).",
          "examples": [
            {
              "ar": "كِتَابٌ ← اَلْكِتَابُ",
              "de": "ein Buch → das Buch"
            }
          ]
        },
        {
          "title": "Sonnen- und Mondbuchstaben",
          "text": "Vor 14 „Sonnenbuchstaben“ (z. B. ت د ر س ش ن) wird das ل von اَلْ nicht gesprochen, der folgende Buchstabe verdoppelt sich: اَلشَّمْسُ (asch-schams). Vor den „Mondbuchstaben“ bleibt das ل hörbar: اَلْقَمَرُ (al-qamar).",
          "examples": [
            {
              "ar": "اَلرَّجُلُ",
              "de": "ar-radschul – der Mann"
            },
            {
              "ar": "اَلْوَلَدُ",
              "de": "al-walad – der Junge"
            }
          ]
        },
        {
          "title": "Ein Satz aus zwei Nomen",
          "text": "Bestimmtes Nomen + unbestimmte Eigenschaft ergibt einen Satz: Das Haus ist groß. Auch hier steht kein „ist“.",
          "examples": [
            {
              "ar": "اَلْبَابُ مَفْتُوحٌ.",
              "de": "Die Tür ist offen."
            },
            {
              "ar": "اَلْحَجَرُ ثَقِيلٌ.",
              "de": "Der Stein ist schwer."
            },
            {
              "ar": "اَلتَّاجِرُ غَنِيٌّ.",
              "de": "Der Händler ist reich."
            }
          ]
        }
      ]
    },
