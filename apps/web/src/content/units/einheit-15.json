          "ablenker": [
            "يَجِبُ أَنا أَنامُ.",
            "أَجِبُ أَنْ أَنامَ.",
            "يَجِبُ أَنْ نِمْتُ."
          ]
        },
        {
          "id": "g-15-2#1",
