      "grammar": [
        {
          "title": "Nach فِي, عَلَى, مِنْ, إِلَى: Endung -i",
          "text": "Diese Wörter heißen „Präpositionen“ (حُرُوفُ الْجَرِّ). Das Nomen danach bekommt statt -u die Endung -i (Genitiv).",
          "examples": [
            {
              "ar": "اَلْكِتَابُ عَلَى الْمَكْتَبِ.",
              "de": "Das Buch liegt auf dem Schreibtisch."
            },
            {
              "ar": "اَلطَّالِبُ فِي الْفَصْلِ.",
              "de": "Der Schüler ist im Klassenzimmer."
            }
          ]
        },
        {
          "title": "Fragen mit أَيْنَ",
          "text": "أَيْنَ fragt nach dem Ort. Die Antwort nennt ihn meist mit einer Präposition.",
          "examples": [
            {
              "ar": "أَيْنَ الْمُدِيرُ؟ هُوَ فِي الْغُرْفَةِ.",
              "de": "Wo ist der Direktor? Er ist im Zimmer."
            }
          ]
        },
        {
          "title": "„Er ging …“: ذَهَبَ und خَرَجَ",
          "text": "Die ersten Verben stehen in der Vergangenheit, 3. Person männlich. ذَهَبَ إِلَى heißt „ging zu“, خَرَجَ مِنْ „ging hinaus aus“.",
          "examples": [
            {
              "ar": "ذَهَبَ الْوَلَدُ إِلَى السُّوقِ.",
              "de": "Der Junge ging zum Markt."
            },
            {
              "ar": "خَرَجَ الطَّبِيبُ مِنَ الْبَيْتِ.",
              "de": "Der Arzt ging aus dem Haus."
            }
          ]
        }
      ]
    },
