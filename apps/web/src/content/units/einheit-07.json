  "dialoge": [
    {
      "id": "d-7-1",
      "einheit": 7,
      "dialog": 1,
      "titel": "في الْكُلِّيَّةِ",
      "zeilen": [
        {
          "sp": "مَرْيَم",
          "ar": "ماذا تَدْرُسُ يا عُمَرُ؟",
          "de": "Was studierst du, ʿUmar?"
        },
        {
          "sp": "عُمَر",
          "ar": "أَدْرُسُ اللُّغَةَ الْعَرَبِيَّةَ في كُلِّيَّةِ اللُّغاتِ.",
          "de": "Ich studiere Arabisch an der Fakultät für Sprachen."
        },
        {
          "sp": "مَرْيَم",
          "ar": "هَلِ الدِّراسَةُ صَعْبَةٌ؟",
          "de": "Ist das Studium schwer?"
        },
        {
          "sp": "عُمَر",
          "ar": "الْقَواعِدُ صَعْبَةٌ، لٰكِنَّ الْكَلِماتِ سَهْلَةٌ.",
          "de": "Die Grammatik ist schwer, aber die Wörter sind leicht."
        },
        {
          "sp": "مَرْيَم",
          "ar": "أَنْتَ طالِبٌ مُجْتَهِدٌ!",
          "de": "Du bist ein fleißiger Student!"
        }
      ]
    },
    {
      "id": "d-7-2",
      "einheit": 7,
      "dialog": 2,
      "titel": "الِامْتِحانُ غَداً",
      "zeilen": [
        {
          "sp": "الْمُدَرِّس",
          "ar": "الِامْتِحانُ غَداً. هَلْ فَهِمْتُمُ الدَّرْسَ؟",
          "de": "Die Prüfung ist morgen. Habt ihr die Lektion verstanden?"
        },
        {
          "sp": "الطُّلّاب",
          "ar": "نَعَمْ، فَهِمْنا.",
          "de": "Ja, wir haben verstanden."
        },
        {
          "sp": "سارَة",
          "ar": "يا أُسْتاذُ، عِنْدي سُؤالٌ.",
          "de": "Herr Lehrer, ich habe eine Frage."
        },
        {
          "sp": "الْمُدَرِّس",
          "ar": "تَفَضَّلي.",
          "de": "Bitte schön."
        },
        {
          "sp": "سارَة",
          "ar": "هَلْ نَكْتُبُ جُمَلاً في الِامْتِحانِ؟",
          "de": "Schreiben wir in der Prüfung Sätze?"
        },
        {
          "sp": "الْمُدَرِّس",
          "ar": "نَعَمْ، تَكْتُبونَ خَمْسَ جُمَلٍ.",
          "de": "Ja, ihr schreibt fünf Sätze."
        }
      ]
    },
    {
      "id": "d-7-3",
      "einheit": 7,
      "dialog": 3,
      "titel": "في الْمَكْتَبَةِ",
      "zeilen": [
        {
          "sp": "مَرْيَم",
          "ar": "ماذا تَتَعَلَّمينَ يا سارَةُ؟",
          "de": "Was lernst du, Sāra?"
        },
        {
          "sp": "سارَة",
          "ar": "أَتَعَلَّمُ كَلِماتِ الدَّرْسِ الْجَديدِ.",
          "de": "Ich lerne die Wörter der neuen Lektion."
        },
        {
          "sp": "مَرْيَم",
          "ar": "هَلِ الدَّرْسُ صَعْبٌ؟",
          "de": "Ist die Lektion schwer?"
        },
        {
          "sp": "سارَة",
          "ar": "لا، هُوَ سَهْلٌ. أَكْتُبُ كُلَّ كَلِمَةٍ في دَفْتَري.",
          "de": "Nein, sie ist leicht. Ich schreibe jedes Wort in mein Heft."
        },
        {
          "sp": "مَرْيَم",
          "ar": "فِكْرَةٌ جَميلَةٌ!",
          "de": "Eine schöne Idee!"
        }
      ]
    }
  ],
  "grammatik": [
    {
      "id": "g-7-1",
      "einheit": 7,
      "abschnitt": 1,
      "titel": "Die Zukunft mit سَـ und سَوْفَ",
      "regel": "سَـ + Präsens: سَأَدْرُسُ = ich werde lernen",
      "erklaerung": [
        "سَـ wird direkt vor das Präsens geschrieben; سَوْفَ steht als eigenes Wort davor und klingt etwas ferner.",
        "Beispiel: الِامْتِحانُ غَداً، سَأَدْرُسُ الْيَوْمَ."
      ],
      "beispiele": [
        {
          "ar": "سَأَذْهَبُ إِلى الْمَكْتَبَةِ.",
          "de": "Ich werde in die Bibliothek gehen."
        },
        {
          "ar": "سَوْفَ نَدْرُسُ مَعاً.",
          "de": "Wir werden zusammen lernen."
        },
        {
          "ar": "مَتى سَتَبْدَأُ الْمُحاضَرَةُ؟",
          "de": "Wann wird die Vorlesung beginnen?"
        }
      ],
      "fragen": [
        {
          "id": "g-7-1#0",
          "frage": "„Ich werde schreiben.“",
          "ar": null,
          "antwort": "سَأَكْتُبُ",
          "ablenker": ["كَتَبْتُ", "أَكْتُبُ", "سَكَتَبَ"]
        },
        {
          "id": "g-7-1#1",
          "frage": "Wo steht سَـ?",
          "ar": null,
          "antwort": "direkt vor dem Präsens",
          "ablenker": ["nach dem Verb", "vor dem Perfekt", "am Satzende"]
        }
      ]
    },
    {
      "id": "g-7-2",
      "einheit": 7,
      "abschnitt": 2,
      "titel": "Der gesunde Plural",
      "regel": "مُدَرِّسونَ Lehrer (m, Pl.) · طالِباتٌ Studentinnen",
      "erklaerung": [
        "Viele Personen-Nomen bilden den Plural mit ـونَ (Maskulin; nach Präpositionen ـينَ): مُدَرِّسونَ, مَعَ الْمُدَرِّسينَ.",
        "Feminine Nomen auf ة bilden den Plural mit ـاتٌ: طالِبَةٌ → طالِباتٌ."
