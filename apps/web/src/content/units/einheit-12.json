  "dialoge": [
    {
      "id": "d-12-1",
      "einheit": 12,
      "dialog": 1,
      "titel": "وَقْتُ الْفَراغِ",
      "zeilen": [
        {
          "sp": "يوسُف",
          "ar": "ماذا تَفْعَلُ في وَقْتِ الْفَراغِ يا عُمَرُ؟",
          "de": "Was machst du in deiner Freizeit, ʿUmar?"
        },
        {
          "sp": "عُمَر",
          "ar": "أَلْعَبُ كُرَةَ الْقَدَمِ مَعَ أَصْدِقائي.",
          "de": "Ich spiele Fußball mit meinen Freunden."
        },
        {
          "sp": "يوسُف",
          "ar": "أَيْنَ تَلْعَبونَ؟",
          "de": "Wo spielt ihr?"
        },
        {
          "sp": "عُمَر",
          "ar": "نَلْعَبُ في مَلْعَبِ الْجامِعَةِ يَوْمَ الْجُمُعَةِ. وَأَنْتَ؟",
          "de": "Wir spielen freitags auf dem Sportplatz der Universität. Und du?"
        },
        {
          "sp": "يوسُف",
          "ar": "أَنا أَسْبَحُ. السِّباحَةُ رِياضَتي الْمُفَضَّلَةُ.",
          "de": "Ich schwimme. Schwimmen ist mein Lieblingssport."
        }
      ]
    },
    {
      "id": "d-12-2",
      "einheit": 12,
      "dialog": 2,
      "titel": "هِوايَةُ سارَةَ",
      "zeilen": [
        {
          "sp": "مَرْيَم",
          "ar": "ما هِوايَتُكِ يا سارَةُ؟",
          "de": "Was ist dein Hobby, Sāra?"
        },
        {
          "sp": "سارَة",
          "ar": "أُحِبُّ الْخَطَّ الْعَرَبِيَّ. أَرْسُمُ الْحُروفَ كُلَّ يَوْمٍ.",
          "de": "Ich liebe die arabische Kalligrafie. Ich zeichne jeden Tag Buchstaben."
        },
        {
          "sp": "مَرْيَم",
          "ar": "ما شاءَ اللهُ، أَنْتِ ماهِرَةٌ!",
          "de": "Wie schön, du bist geschickt!"
        },
        {
          "sp": "سارَة",
          "ar": "وَأَنْتِ؟",
          "de": "Und du?"
        },
        {
          "sp": "مَرْيَم",
          "ar": "هِوايَتي الْقِراءَةُ. أَقْرَأُ قِصَصاً مُمْتِعَةً.",
          "de": "Mein Hobby ist Lesen. Ich lese spannende Geschichten."
        }
      ]
    },
    {
      "id": "d-12-3",
      "einheit": 12,
      "dialog": 3,
      "titel": "قِصَّةٌ مُمْتِعَةٌ",
      "zeilen": [
        {
          "sp": "الْأَب",
          "ar": "ماذا تَقْرَأُ يا يوسُفُ؟",
          "de": "Was liest du, Yūsuf?"
        },
        {
          "sp": "يوسُف",
          "ar": "أَقْرَأُ قِصَّةً عَنْ رِحْلَةٍ في الصَّحْراءِ.",
          "de": "Ich lese eine Geschichte über eine Reise in der Wüste."
        },
        {
          "sp": "الْأَب",
          "ar": "هَلْ هِيَ مُمْتِعَةٌ؟",
          "de": "Ist sie spannend?"
        },
        {
          "sp": "يوسُف",
          "ar": "نَعَمْ، جِدّاً. أَقْرَأُ كُلَّ يَوْمٍ قَبْلَ النَّوْمِ.",
          "de": "Ja, sehr. Ich lese jeden Tag vor dem Schlafengehen."
        }
      ]
    }
  ]
}
