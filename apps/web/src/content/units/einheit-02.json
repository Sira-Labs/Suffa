  "dialoge": [
    {
      "id": "d-2-1",
      "einheit": 2,
      "dialog": 1,
      "titel": "صُورَةُ الْأُسْرَةِ",
      "zeilen": [
        {
          "sp": "عُمَر",
          "ar": "مَنْ هٰذا في الصّورَةِ؟",
          "de": "Wer ist das auf dem Foto?"
        },
        {
          "sp": "يوسُف",
          "ar": "هٰذا أَبي، وَهٰذِهِ أُمّي.",
          "de": "Das ist mein Vater, und das ist meine Mutter."
        },
        {
          "sp": "عُمَر",
          "ar": "ما شاءَ اللهُ! وَمَنْ هٰذا الْوَلَدُ الصَّغيرُ؟",
          "de": "Wie schön! Und wer ist dieser kleine Junge?"
        },
        {
          "sp": "يوسُف",
          "ar": "هٰذا أَخي خالِدٌ. هُوَ طالِبٌ.",
          "de": "Das ist mein Bruder Chālid. Er ist Schüler."
        },
        {
          "sp": "عُمَر",
          "ar": "وَمَنْ هٰذِهِ؟",
          "de": "Und wer ist das?"
        },
        {
          "sp": "يوسُف",
          "ar": "هٰذِهِ أُخْتي فاطِمَةُ. هِيَ طَبيبَةٌ.",
          "de": "Das ist meine Schwester Fāṭima. Sie ist Ärztin."
        }
      ]
    },
    {
      "id": "d-2-2",
      "einheit": 2,
      "dialog": 2,
      "titel": "أُسْرَةٌ كَبيرَةٌ",
      "zeilen": [
        {
          "sp": "سارَة",
          "ar": "هَلْ لَكِ أَخٌ يا مَرْيَمُ؟",
          "de": "Hast du einen Bruder, Maryam?"
        },
        {
          "sp": "مَرْيَم",
          "ar": "نَعَمْ، لي أَخٌ وَأُخْتانِ.",
          "de": "Ja, ich habe einen Bruder und zwei Schwestern."
        },
        {
          "sp": "سارَة",
          "ar": "ما شاءَ اللهُ! أُسْرَتُكِ كَبيرَةٌ.",
          "de": "Wie schön! Deine Familie ist groß."
        },
        {
          "sp": "مَرْيَم",
          "ar": "وَأَنْتِ؟",
          "de": "Und du?"
        },
        {
          "sp": "سارَة",
          "ar": "أُسْرَتي صَغيرَةٌ: أَنا وَأَبي وَأُمّي.",
          "de": "Meine Familie ist klein: ich, mein Vater und meine Mutter."
        }
      ]
    }
  ]
}
