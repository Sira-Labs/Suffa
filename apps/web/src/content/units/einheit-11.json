  "dialoge": [
    {
      "id": "d-11-1",
      "einheit": 11,
      "dialog": 1,
      "titel": "عاصِمَةُ مِصْرَ",
      "zeilen": [
        {
          "sp": "سارَة",
          "ar": "هَلْ تَعْرِفُ مَدينَةَ الْقاهِرَةِ؟",
          "de": "Kennst du die Stadt Kairo?"
        },
        {
          "sp": "عُمَر",
          "ar": "نَعَمْ، أَعْرِفُها. هِيَ عاصِمَةُ مِصْرَ.",
          "de": "Ja, ich kenne sie. Sie ist die Hauptstadt Ägyptens."
        },
        {
          "sp": "سارَة",
          "ar": "هَلْ هِيَ مَدينَةٌ قَديمَةٌ؟",
          "de": "Ist sie eine alte Stadt?"
        },
        {
          "sp": "عُمَر",
          "ar": "نَعَمْ، وَفيها نَهْرُ النّيلِ وَمَتاحِفُ مَشْهورَةٌ.",
          "de": "Ja, und dort sind der Nil und berühmte Museen."
        },
        {
          "sp": "سارَة",
          "ar": "ما شاءَ اللهُ!",
          "de": "Wie schön!"
        }
      ]
    },
    {
      "id": "d-11-2",
      "einheit": 11,
      "dialog": 2,
      "titel": "الْخَريطَةُ",
      "zeilen": [
        {
          "sp": "الْمُدَرِّس",
          "ar": "اُنْظُروا إِلى الْخَريطَةِ. أَيْنَ الرِّياضُ؟",
          "de": "Schaut auf die Landkarte. Wo liegt Riad?"
        },
        {
          "sp": "يوسُف",
          "ar": "الرِّياضُ في وَسَطِ الْمَمْلَكَةِ.",
          "de": "Riad liegt in der Mitte des Königreichs."
        },
        {
          "sp": "الْمُدَرِّس",
          "ar": "وَأَيْنَ مَكَّةُ؟",
          "de": "Und wo liegt Mekka?"
        },
        {
          "sp": "مَرْيَم",
          "ar": "مَكَّةُ في الْغَرْبِ، قَريبَةٌ مِنَ الْبَحْرِ.",
          "de": "Mekka liegt im Westen, nahe am Meer."
        },
        {
          "sp": "الْمُدَرِّس",
          "ar": "أَحْسَنْتُمْ!",
          "de": "Gut gemacht!"
        }
      ]
    },
    {
      "id": "d-11-3",
      "einheit": 11,
      "dialog": 3,
      "titel": "نَمْشي إِلى الْمَتْحَفِ",
      "zeilen": [
        {
          "sp": "سارَة",
          "ar": "هَلْ نَمْشي إِلى الْمَتْحَفِ؟",
          "de": "Gehen wir zu Fuß zum Museum?"
        },
        {
          "sp": "مَرْيَم",
          "ar": "هَلْ هُوَ قَريبٌ؟",
          "de": "Ist es nah?"
        },
        {
          "sp": "سارَة",
          "ar": "نَعَمْ، هُوَ في شارِعٍ قَريبٍ، أَمامَ الْمَسْجِدِ الْقَديمِ.",
          "de": "Ja, es liegt in einer Straße in der Nähe, vor der alten Moschee."
        },
        {
          "sp": "مَرْيَم",
          "ar": "طَيِّبٌ، نَمْشي. الْجَوُّ جَميلٌ.",
          "de": "Gut, wir gehen zu Fuß. Das Wetter ist schön."
        }
      ]
    }
  ]
}
