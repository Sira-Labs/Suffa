          "antwort": "عَلى",
          "ablenker": ["تَحْتَ", "مِنْ", "أَيْنَ"]
        },
        {
          "id": "g-3-1#1",
          "frage": "Welche Endung hat das Nomen nach في?",
          "ar": "في الْبَيْت…",
          "antwort": "-i (Genitiv): الْبَيْتِ",
          "ablenker": ["-u: الْبَيْتُ", "-a: الْبَيْتَ", "-un: بَيْتٌ"]
        }
      ]
    },
    {
      "id": "g-3-2",
      "einheit": 3,
      "abschnitt": 2,
      "titel": "Bestimmt und unbestimmt",
      "regel": "بَيْتٌ ein Haus · الْبَيْتُ das Haus",
      "erklaerung": [
        "Unbestimmte Nomen tragen Tanwīn (-un, -in, -an), bestimmte den Artikel ال ohne Tanwīn.",
        "Vor Sonnenbuchstaben (ت د ر س ش ص ن …) wird das l von ال nicht gesprochen, der Buchstabe verdoppelt sich: الشَّقَّةُ (asch-schaqqa)."
      ],
      "beispiele": [
        {
          "ar": "شَقَّةٌ جَديدَةٌ",
          "de": "eine neue Wohnung"
        },
        {
          "ar": "الشَّقَّةُ جَديدَةٌ.",
          "de": "Die Wohnung ist neu."
        },
        {
          "ar": "الْغُرْفَةُ كَبيرَةٌ.",
          "de": "Das Zimmer ist groß."
        }
      ],
      "fragen": [
        {
          "id": "g-3-2#0",
          "frage": "Bei welchem Wort wird das l von ال nicht gesprochen?",
          "ar": null,
          "antwort": "السَّريرُ",
          "ablenker": ["الْقَمَرُ", "الْبابُ", "الْمَطْبَخُ"]
        },
        {
          "id": "g-3-2#1",
          "frage": "Welche Form bedeutet „ein Zimmer“?",
          "ar": null,
          "antwort": "غُرْفَةٌ",
          "ablenker": ["الْغُرْفَةُ", "غُرْفَتي", "الْغُرْفَةِ"]
        }
      ]
    },
    {
      "id": "g-3-3",
      "einheit": 3,
      "abschnitt": 3,
      "titel": "هُناكَ – es gibt",
      "regel": "هُناكَ + Nomen = es gibt …",
      "erklaerung": [
        "هُناكَ heißt „dort“, am Satzanfang aber auch „es gibt“: هُناكَ مَسْجِدٌ قَريبٌ – Es gibt eine Moschee in der Nähe.",
        "هُنا heißt „hier“: أَسْكُنُ هُنا – Ich wohne hier."
      ],
      "beispiele": [
