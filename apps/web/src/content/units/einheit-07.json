          "ablenker": ["مُسْلِماتٌ", "مُسْلِمَيْنِ", "مَساليمُ"]
        }
      ]
    },
    {
      "id": "g-7-3",
      "einheit": 7,
      "abschnitt": 3,
      "titel": "Verneinung der Vergangenheit mit ما",
      "regel": "ما + Perfekt: ما ذَهَبْتُ = ich bin nicht gegangen",
      "erklaerung": [
        "ما vor dem Perfekt verneint eine vergangene Handlung; das Verb bleibt unverändert.",
        "In Einheit 16 kommt die zweite, häufigere Form hinzu: لَمْ + Präsens (Jussiv)."
      ],
      "beispiele": [
