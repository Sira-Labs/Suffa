  "dialoge": [
    {
      "id": "d-10-1",
      "einheit": 10,
      "dialog": 1,
      "titel": "كَيْفَ الْجَوُّ؟",
      "zeilen": [
        {
          "sp": "مَرْيَم",
          "ar": "كَيْفَ الْجَوُّ في الرِّياضِ الْيَوْمَ؟",
          "de": "Wie ist das Wetter heute in Riad?"
        },
        {
          "sp": "عُمَر",
          "ar": "الْجَوُّ حارٌّ جِدّاً، وَالشَّمْسُ تَسْطَعُ.",
          "de": "Es ist sehr heiß, und die Sonne scheint."
        },
        {
          "sp": "مَرْيَم",
          "ar": "كَمْ دَرَجَةُ الْحَرارَةِ؟",
          "de": "Wie hoch ist die Temperatur?"
        },
        {
          "sp": "عُمَر",
          "ar": "أَرْبَعونَ دَرَجَةً! وَكَيْفَ الْجَوُّ في أَلْمانِيا؟",
          "de": "Vierzig Grad! Und wie ist das Wetter in Deutschland?"
        },
        {
          "sp": "مَرْيَم",
          "ar": "الْجَوُّ بارِدٌ وَغائِمٌ، وَالْمَطَرُ يَنْزِلُ.",
          "de": "Es ist kalt und bewölkt, und es regnet."
        }
      ]
    },
    {
      "id": "d-10-2",
      "einheit": 10,
      "dialog": 2,
      "titel": "أَيُّ فَصْلٍ تُحِبُّ؟",
      "zeilen": [
        {
          "sp": "سارَة",
          "ar": "أَيُّ فَصْلٍ تُحِبُّ يا يوسُفُ؟",
          "de": "Welche Jahreszeit magst du, Yūsuf?"
        },
        {
          "sp": "يوسُف",
          "ar": "أُحِبُّ الرَّبيعَ لِأَنَّ الْجَوَّ مُعْتَدِلٌ.",
          "de": "Ich mag den Frühling, weil das Wetter mild ist."
        },
        {
          "sp": "سارَة",
          "ar": "أَنا أُحِبُّ الشِّتاءَ.",
          "de": "Ich mag den Winter."
        },
        {
          "sp": "يوسُف",
          "ar": "لِماذا؟",
          "de": "Warum?"
        },
        {
          "sp": "سارَة",
          "ar": "لِأَنَّ الثَّلْجَ يَنْزِلُ في الشِّتاءِ في بَلَدي.",
          "de": "Weil in meinem Land im Winter Schnee fällt."
        }
      ]
    }
  ]
}
