# Web app configuration (Vite). Copy to `.env` for local development.
# IMPORTANT: the real `.env` is in .gitignore and must NEVER be committed.

# Which sync backend the app uses:
#   api      – Suffa's own API on the same origin (magic-link sign-in; default without Supabase keys)
#   supabase – the old Supabase project (until the migration, story 4.1)
#   off      – pure offline mode
# VITE_SYNC_BACKEND=api

# Local development: the Vite server proxies /api to this address (npm start -w @suffa/api).
# SUFFA_API_URL=http://localhost:8000

# Supabase (only for VITE_SYNC_BACKEND=supabase). The anon key is public; RLS protects data.
# VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: disable sync entirely (same as VITE_SYNC_BACKEND=off).
VITE_SYNC_ENABLED=true
